datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  bio       String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("profiles")
}

model Project {
  id            String       @id @default(uuid())
  title         String
  description   String?
  repositoryUrl String
  upvotes       Int          @default(0)
  averageRating Float        @default(0)
  profileId     String
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  technologies  Technology[]
  feedbacks     Feedback[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("projects")
}

model Technology {
  id        String    @id @default(uuid())
  name      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())

  @@map("technologies")
}

model Feedback {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorName String
  comment    String
  rating     Int
  createdAt  DateTime @default(now())

  @@map("feedbacks")
}
